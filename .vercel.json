{
  "version": 2,
  "buildCommand": "next build --webpack",
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  },
  "build": {
    "env": {
      "NODE_ENV": "production",
      "FORCE_WEBPACK_BUILD": "true"
    }
  }
}

